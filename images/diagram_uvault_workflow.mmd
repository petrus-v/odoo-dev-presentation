    B1 --> C["3. Monitor PR\nuvault status"]
    B1 --> D["4. Local Dev Mode\nuvault develop <pkg> <branch>"]
    
    D -->|"Edit code in ./.src/"| D1["[tool.uv.sources]\npath = './.src/...' editable = true"]
    D1 --> E["5. Release Production\nuvault release"]
    E -->|"Freeze release tag"| E1["Tag: 1.0.0+apycod.pkg"]

